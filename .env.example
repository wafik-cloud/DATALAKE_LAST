# =============================================================================
# DATALAKE_LAST — variables d'environnement (copier vers .env)
# =============================================================================

# --- Application ---
NODE_ENV=development
API_PORT=5001
# UI : exécuter  bash scripts/assign-web-port.sh  pour détecter un port libre
WEB_PORT=
APP_URL=
API_URL=http://localhost:5001

# --- PostgreSQL ---
POSTGRES_USER=datalake
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=datalake
DATABASE_URL=postgresql://datalake:CHANGE_ME_STRONG_PASSWORD@postgres:5432/datalake

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=pelagic-data
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# --- Pelagic Data API ---
# Token : identifiant dans l'URL  →  .../api/{TOKEN}/v1/trips/...
# Secret : header HTTP X-API-SECRET (ne jamais committer)
PELAGIC_API_BASE_URL=https://analytics.pelagicdata.com/api
PELAGIC_API_TOKEN=COLLEZ_VOTRE_TOKEN_ICI
PELAGIC_API_SECRET=COLLEZ_VOTRE_SECRET_ICI

# --- Planification Pelagic ---
PELAGIC_SYNC_ENABLED=true
PELAGIC_SYNC_EXPORT_TYPES=trips
PELAGIC_SYNC_CRON=0 2 * * *
PELAGIC_SYNC_TIMEZONE=Africa/Casablanca
PELAGIC_SYNC_DEFAULT_IMEIS=
PELAGIC_SYNC_DEVICE_INFO=true
PELAGIC_SYNC_WITH_LAST_SEEN=true
PELAGIC_SYNC_INCLUDE_ERRANT=false
PELAGIC_SYNC_TAGS=
PELAGIC_HTTP_TIMEOUT_MS=120000
PELAGIC_HTTP_MAX_RETRIES=3

# --- Auth (admin) — phase 2 : header X-Admin-Key ---
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

# --- Keycloak (optionnel, phase ultérieure) ---
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=datalake
# KEYCLOAK_CLIENT_ID=datalake-web
